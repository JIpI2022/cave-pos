# Copier ce fichier en « .env » puis renseigner les 2 valeurs
# (Supabase > Project Settings > API)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Optionnel : chemin de base pour GitHub Pages (ex. /cave-pos/).
# Laisser vide en developpement local.
# VITE_BASE_PATH=/cave-pos/
